# ChaiQ App Builder Environment Configuration

# Application Settings
APP_TITLE="ChaiQ App Builder - Personal Workspace"
APP_VERSION="1.0.0"
ENVIRONMENT="production"

# UI Configuration  
DEFAULT_THEME="gradient1"
ENABLE_ANIMATIONS="true"
SHOW_DESKTOP_ICONS="true"

# Storage Settings
STORAGE_KEY_PREFIX="limedrop"
AUTO_SAVE_ENABLED="true"
SETTINGS_STORAGE_KEY="limedrop-settings"
WELCOME_STORAGE_KEY="limedrop-welcomed"

# External Resources
FONTAWESOME_CDN_URL="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"

# Development Settings
DEV_PORT="8080"
PROD_CACHE_DURATION="3600"

# Feature Flags
ENABLE_WELCOME_MESSAGE="true"
ENABLE_WINDOW_PERSISTENCE="true"
ENABLE_COMPONENT_DEBUGGING="false"